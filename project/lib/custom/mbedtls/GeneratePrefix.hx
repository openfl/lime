import haxe.io.Path;
import sys.FileSystem;
import sys.io.File;
import sys.io.Process;

using StringTools;

// Writes lime_mbedtls_prefix.h, which gives every global mbedtls_ and psa_
// symbol of Lime's mbedTLS a lime_ prefix, so it never clashes with another
// copy linked beside it, such as hxcpp's. The names come from nm on built
// objects or libraries (or folders of them, such as project/obj), lime_ prefix
// or not, and are added to those already in the header: run it on builds for
// each architecture, from project/lib/custom/mbedtls:
//
//   haxe --run GeneratePrefix [-fresh] ../../../obj
//
// -fresh starts from an empty list, as after an mbedTLS update. -check writes
// nothing and fails if any of them has an mbedtls_ or psa_ symbol left
// without the prefix. NM sets the nm to use.
class GeneratePrefix
{
	static var header = "lime_mbedtls_prefix.h";
	static var symbol = ~/^_?(lime_)?((mbedtls|psa)_[A-Za-z0-9_]+)$/;

	static function main()
	{
		var args = Sys.args();
		var check = args.remove("-check");
		var fresh = args.remove("-fresh");
		if (args.length == 0)
		{
			Sys.println("Usage: haxe --run GeneratePrefix [-fresh|-check] <objects, libraries or folders>");
			Sys.exit(1);
		}

		var files = [];
		for (arg in args) collect(arg, files);
		if (files.length == 0)
		{
			Sys.println("No objects or libraries found in " + args.join(", "));
			Sys.exit(1);
		}

		var names = new Map<String, Bool>();
		var unprefixed = new Map<String, Bool>();
		for (file in files)
		{
			for (name in definedSymbols(file))
			{
				if (!symbol.match(name)) continue;
				names.set(symbol.matched(2), true);
				if (symbol.matched(1) == null) unprefixed.set(symbol.matched(2), true);
			}
		}

		if (check)
		{
			var leaks = sorted(unprefixed);
			for (name in leaks) Sys.println(name);
			Sys.println(leaks.length + " unprefixed in " + files.length + " files");
			Sys.exit(leaks.length > 0 ? 1 : 0);
		}

		if (!fresh && FileSystem.exists(header))
		{
			var define = ~/^#define ([A-Za-z0-9_]+) lime_/;
			for (line in File.getContent(header).split("\n"))
			{
				if (define.match(line.trim())) names.set(define.matched(1), true);
			}
		}

		var output = new StringBuf();
		output.add("// Generated by GeneratePrefix.hx\n\n#ifndef LIME_MBEDTLS_PREFIX_H\n#define LIME_MBEDTLS_PREFIX_H\n\n");
		var list = sorted(names);
		for (name in list)
		{
			output.add('#define $name lime_$name\n');
		}
		output.add("\n#endif\n");
		File.saveContent(header, output.toString());
		Sys.println(list.length + " names from " + files.length + " files");
	}

	static function collect(path:String, files:Array<String>):Void
	{
		if (!FileSystem.exists(path)) return;
		if (FileSystem.isDirectory(path))
		{
			for (entry in FileSystem.readDirectory(path))
			{
				collect(Path.join([path, entry]), files);
			}
		}
		else if (~/\.(o|obj|a|lib)$/i.match(path))
		{
			files.push(path);
		}
	}

	static function definedSymbols(file:String):Array<String>
	{
		var nm = Sys.getEnv("NM");
		var process = new Process(nm != null && nm != "" ? nm : "nm", ["-g", file]);
		var output = process.stdout.readAll().toString();
		process.stderr.readAll();
		process.close();

		var result = [];
		for (line in output.split("\n"))
		{
			var parts = line.trim().split(" ").filter(part -> part != "");
			if (parts.length < 2) continue;
			var type = parts[parts.length - 2];
			if (type.length == 1 && type != "U" && type == type.toUpperCase())
			{
				result.push(parts[parts.length - 1]);
			}
		}
		return result;
	}

	static function sorted(map:Map<String, Bool>):Array<String>
	{
		var list = [for (name in map.keys()) name];
		list.sort((a, b) -> a < b ? -1 : (a > b ? 1 : 0));
		return list;
	}
}
