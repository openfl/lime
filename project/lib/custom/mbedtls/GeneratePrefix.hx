import haxe.io.Path;
import sys.FileSystem;
import sys.io.File;
import sys.io.Process;

using StringTools;

// Writes lime_mbedtls_prefix.h, which gives every mbedtls_ and psa_ name in
// Lime's mbedTLS a lime_ prefix, so it never clashes with another copy linked
// beside it, such as hxcpp's. Run it after updating the mbedtls submodule:
//
//   haxe --cwd project/lib/custom/mbedtls --run GeneratePrefix
//
// -check <objects, libraries or folders> instead runs nm (or NM) on built code
// and fails if any mbedtls_ or psa_ symbol is left without the prefix.
class GeneratePrefix
{
	static var header = "lime_mbedtls_prefix.h";

	static function main()
	{
		var args = Sys.args();
		if (args.remove("-check"))
		{
			check(args);
		}
		else
		{
			generate();
		}
	}

	static function generate():Void
	{
		var noise = ~/\/\/[^\n]*|\/\*[\s\S]*?\*\/|"(\\.|[^"\\\n])*"|'(\\.|[^'\\\n])*'|^[ \t]*#[ \t]*include[^\n]*/gm;
		var define = ~/^[ \t]*#[ \t]*define[ \t]+((mbedtls|psa)_[A-Za-z0-9_]+)(\(?)/m;
		var identifier = ~/\b(mbedtls|psa)_[A-Za-z0-9_]+\b/;

		var names = new Map<String, Bool>();
		var objectMacros = new Map<String, Bool>();
		var functionMacros = new Map<String, Bool>();
		var library = [];

		for (path in sources("../../mbedtls/include").concat(sources("../../mbedtls/library")))
		{
			var text = noise.replace(File.getContent(path), " ");
			if (path.indexOf("/library/") > -1 && path.endsWith(".c")) library.push(text);

			var rest = text;
			while (define.match(rest))
			{
				(define.matched(3) == "(" ? functionMacros : objectMacros).set(define.matched(1), true);
				rest = define.matchedRight();
			}

			rest = text;
			while (identifier.match(rest))
			{
				names.set(identifier.matched(0), true);
				rest = identifier.matchedRight();
			}
		}

		var list = [];
		for (name in names.keys())
		{
			if (objectMacros.exists(name)) continue;
			// A function-like macro in some configurations can be a function in others
			if (functionMacros.exists(name) && !definesFunction(library, name)) continue;
			list.push(name);
		}
		list.sort((a, b) -> a < b ? -1 : (a > b ? 1 : 0));

		var output = new StringBuf();
		output.add("// Generated by GeneratePrefix.hx\n\n#ifndef LIME_MBEDTLS_PREFIX_H\n#define LIME_MBEDTLS_PREFIX_H\n\n");
		for (name in list)
		{
			output.add('#define $name lime_$name\n');
		}
		output.add("\n#endif\n");
		File.saveContent(header, output.toString());
		Sys.println(list.length + " names");
	}

	static function definesFunction(library:Array<String>, name:String):Bool
	{
		var definition = new EReg("^(?!static\\b)[A-Za-z_][^\\n;{}#]*\\b" + name + "\\s*\\([^;{}]*\\)\\s*\\{", "m");
		for (text in library)
		{
			if (definition.match(text)) return true;
		}
		return false;
	}

	static function check(args:Array<String>):Void
	{
		var files = [];
		for (arg in args) collect(arg, files);
		if (files.length == 0)
		{
			Sys.println("No objects or libraries found in " + args.join(", "));
			Sys.exit(1);
		}

		var symbol = ~/^_?(lime_)?((mbedtls|psa)_[A-Za-z0-9_]+)$/;
		var names = new Map<String, Bool>();
		var leaks = new Map<String, Bool>();
		for (file in files)
		{
			for (name in definedSymbols(file))
			{
				if (!symbol.match(name)) continue;
				names.set(symbol.matched(2), true);
				if (symbol.matched(1) == null) leaks.set(symbol.matched(2), true);
			}
		}

		var leaked = [for (name in leaks.keys()) name];
		leaked.sort((a, b) -> a < b ? -1 : (a > b ? 1 : 0));
		for (name in leaked) Sys.println(name);
		var total = [for (name in names.keys()) name].length;
		Sys.println(leaked.length + " of " + total + " mbedTLS symbols unprefixed in " + files.length + " files");
		// None at all means nm's output wasn't understood, or there was no mbedTLS to check
		Sys.exit(leaked.length > 0 || total == 0 ? 1 : 0);
	}

	static function collect(path:String, files:Array<String>):Void
	{
		if (!FileSystem.exists(path)) return;
		if (FileSystem.isDirectory(path))
		{
			for (entry in FileSystem.readDirectory(path))
			{
				collect(Path.join([path, entry]), files);
			}
		}
		else if (~/\.(o|obj|a|lib)$/i.match(path))
		{
			files.push(path);
		}
	}

	static function definedSymbols(file:String):Array<String>
	{
		var nm = Sys.getEnv("NM");
		var process = new Process(nm != null && nm != "" ? nm : "nm", ["-g", file]);
		var output = process.stdout.readAll().toString();
		process.stderr.readAll();
		process.close();

		var result = [];
		for (line in output.split("\n"))
		{
			var parts = line.trim().split(" ").filter(part -> part != "");
			if (parts.length < 2) continue;
			var type = parts[parts.length - 2];
			if (type.length == 1 && type != "U" && type == type.toUpperCase())
			{
				result.push(parts[parts.length - 1]);
			}
		}
		return result;
	}

	static function sources(directory:String):Array<String>
	{
		var result = [];
		for (entry in FileSystem.readDirectory(directory))
		{
			var path = directory + "/" + entry;
			if (FileSystem.isDirectory(path))
			{
				result = result.concat(sources(path));
			}
			else if (entry.endsWith(".c") || entry.endsWith(".h"))
			{
				result.push(path);
			}
		}
		return result;
	}
}
