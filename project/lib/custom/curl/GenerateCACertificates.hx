import sys.io.File;

using StringTools;

// Writes ca_certificates.h, the Mozilla CA certificates Lime's curl trusts
// where the system has none to offer. Download the bundle curl publishes,
// check it against its .sha256, then from project/lib/custom/curl:
//
//   haxe --run GenerateCACertificates cacert.pem
class GenerateCACertificates
{
	static function main()
	{
		var source = File.getContent(Sys.args()[0]).replace("\r\n", "\n");

		var date = ~/Certificate data from Mozilla as of: ([^\n]*)/;
		var block = ~/-----BEGIN CERTIFICATE-----\n[\s\S]*?-----END CERTIFICATE-----\n/;

		var output = new StringBuf();
		output.add("// Generated by GenerateCACertificates.hx from https://curl.se/ca/cacert.pem\n");
		if (date.match(source)) output.add("// Certificate data from Mozilla as of: " + date.matched(1) + "\n");
		output.add("//\n// This Source Code Form is subject to the terms of the Mozilla Public License,\n// v. 2.0. If a copy of the MPL was not distributed with this file, You can\n// obtain one at https://mozilla.org/MPL/2.0/.\n");
		output.add("\nstatic const char* lime_ca_certificates[] = {\n");

		var count = 0;
		var rest = source;
		while (block.match(rest))
		{
			output.add("\n");
			for (line in block.matched(0).split("\n"))
			{
				if (line != "") output.add("\t\"" + line + "\\n\"\n");
			}
			output.add("\t,\n");
			count++;
			rest = block.matchedRight();
		}

		output.add("\n};\n");
		File.saveContent("ca_certificates.h", output.toString());
		Sys.println(count + " certificates");
	}
}
