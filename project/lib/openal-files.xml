<xml>

    <!-- OpenAL Soft 1.25.2. Its sources need C++20, which hxcpp applies
         through the cxx_standard attribute (hxcpp 4.3.135 or later). The
         generated headers that its CMake build would write are kept in
         custom/openal/build, and the SIMD mixers are compiled through the
         wrappers in custom/openal/simd. -->

    <section if="android LIME_OPENALSOFT">
        <error value="NDK version 26 or higher is required." unless="NDKV26+" />
    </section>

    <files id="native-toolkit-openal" cxx_standard="20">

        <compilerflag value="-I${NATIVE_TOOLKIT_PATH}/custom/openal/build/" />
        <compilerflag value="-I${NATIVE_TOOLKIT_PATH}/openal/" />
        <compilerflag value="-I${NATIVE_TOOLKIT_PATH}/openal/common/" />
        <compilerflag value="-I${NATIVE_TOOLKIT_PATH}/openal/include/" />
        <compilerflag value="-I${NATIVE_TOOLKIT_PATH}/openal/gsl/include/" />
        <compilerflag value="-I${NATIVE_TOOLKIT_PATH}/openal/fmt-11.2.0/include/" />
        <compilerflag value="-DAL_LIBTYPE_STATIC" if="native_toolkit_openal_static" />

        <compilerflag value="-DAL_BUILD_LIBRARY" />
        <compilerflag value="-DAL_ALEXT_PROTOTYPES" />

        <!-- OpenAL Soft's default STL hardening level ("Performance") -->
        <compilerflag value="-D_MSVC_STL_HARDENING=1" if="isMsvc" />
        <compilerflag value="-D_GLIBCXX_ASSERTIONS=1" unless="isMsvc" />
        <compilerflag value="-D_LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_FAST" unless="isMsvc" />

        <file name="${NATIVE_TOOLKIT_PATH}/openal/al/auxeffectslot.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/al/buffer.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/al/debug.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/al/effect.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/al/effects/autowah.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/al/effects/chorus.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/al/effects/compressor.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/al/effects/convolution.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/al/effects/dedicated.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/al/effects/distortion.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/al/effects/echo.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/al/effects/effects.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/al/effects/equalizer.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/al/effects/fshifter.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/al/effects/modulator.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/al/effects/null.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/al/effects/pshifter.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/al/effects/reverb.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/al/effects/vmorpher.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/al/error.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/al/event.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/al/extension.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/al/filter.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/al/listener.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/al/source.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/al/state.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/alc/alc.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/alc/alconfig.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/alc/alu.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/alc/backends/base.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/alc/backends/loopback.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/alc/backends/null.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/alc/backends/wave.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/alc/context.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/alc/device.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/alc/effects/autowah.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/alc/effects/chorus.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/alc/effects/compressor.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/alc/effects/convolution.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/alc/effects/dedicated.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/alc/effects/distortion.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/alc/effects/echo.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/alc/effects/equalizer.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/alc/effects/fshifter.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/alc/effects/modulator.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/alc/effects/null.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/alc/effects/pshifter.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/alc/effects/reverb.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/alc/effects/vmorpher.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/alc/events.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/alc/panning.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/common/alcomplex.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/common/almalloc.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/common/alstring.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/common/althrd_setname.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/common/altypes.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/common/dynload.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/common/filesystem.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/common/pffft.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/common/polyphase_resampler.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/common/strutils.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/core/ambdec.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/core/ambidefs.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/core/bformatdec.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/core/bs2b.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/core/bsinc_tables.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/core/context.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/core/converter.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/core/cpu_caps.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/core/cubic_tables.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/core/devformat.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/core/device.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/core/effectslot.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/core/except.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/core/filters/biquad.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/core/filters/nfc.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/core/filters/splitter.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/core/fpu_ctrl.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/core/helpers.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/core/hrtf.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/core/hrtf_loader.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/core/hrtf_resource.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/core/logging.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/core/mastering.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/core/mixer.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/core/mixer/mixer_c.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/core/storage_formats.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/core/tsmefilter.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/core/uhjfilter.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/core/uiddefs.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/core/voice.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/fmt-11.2.0/src/format.cc" />
        <file name="${NATIVE_TOOLKIT_PATH}/openal/fmt-11.2.0/src/os.cc" />

        <!-- Each wrapper compiles its mixer only if config_simd.h enables it -->
        <file name="${NATIVE_TOOLKIT_PATH}/custom/openal/simd/mixer_neon.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/custom/openal/simd/mixer_sse.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/custom/openal/simd/mixer_sse2.cpp" />
        <file name="${NATIVE_TOOLKIT_PATH}/custom/openal/simd/mixer_sse41.cpp" />

        <compilerflag value="-mmmx" if="linux || mac || mingw" unless="rpi || HXCPP_ARM64" />
        <compilerflag value="-msse" if="linux || mac || mingw" unless="rpi || HXCPP_ARM64" />
        <compilerflag value="-msse2" if="linux || mac || mingw" unless="rpi || HXCPP_ARM64" />
        <compilerflag value="-msse3" if="linux || mac || mingw" unless="rpi || HXCPP_ARM64" />
        <compilerflag value="-mssse3" if="linux || mac || mingw" unless="rpi || HXCPP_ARM64" />

        <section if="NATIVE_TOOLKIT_HAVE_SDL">

            <compilerflag value="-I${NATIVE_TOOLKIT_PATH}/custom/sdl/include/" />
            <compilerflag value="-I${NATIVE_TOOLKIT_PATH}/sdl/include/" />
            <compilerflag value="-I${NATIVE_TOOLKIT_PATH}/sdl/include/configs/default/" unless="windows || mac || linux || rpi" />
            <compilerflag value="-I${NATIVE_TOOLKIT_PATH}/sdl/include/configs/linux/" if="linux" unless="rpi" />
            <compilerflag value="-I${NATIVE_TOOLKIT_PATH}/sdl/include/configs/mac/" if="mac" />
            <compilerflag value="-I${NATIVE_TOOLKIT_PATH}/sdl/include/configs/rpi/" if="rpi" />
            <compilerflag value="-I${NATIVE_TOOLKIT_PATH}/sdl/include/configs/windows/" if="windows" />

            <compilerflag value="-DHAVE_SDL2=1" />
            <file name="${NATIVE_TOOLKIT_PATH}/openal/alc/backends/sdl2.cpp" />

        </section>

        <section if="linux">

            <compilerflag value="-mfpu=neon" if="rpi" unless="HXCPP_ARM64" />

            <file name="${NATIVE_TOOLKIT_PATH}/openal/alc/backends/alsa.cpp" />
            <file name="${NATIVE_TOOLKIT_PATH}/openal/alc/backends/oss.cpp" />
            <file name="${NATIVE_TOOLKIT_PATH}/openal/alc/backends/pulseaudio.cpp" />

        </section>

        <section if="mac">

            <!-- Before macOS 10.13 the system has no aligned operator new, so
                 common/almalloc.cpp supplies one, and Clang only uses it with this -->
            <compilerflag value="-faligned-allocation" />

            <file name="${NATIVE_TOOLKIT_PATH}/openal/alc/backends/coreaudio.cpp" />

        </section>

        <section if="windows">

            <file name="${NATIVE_TOOLKIT_PATH}/openal/alc/backends/dsound.cpp" />
            <file name="${NATIVE_TOOLKIT_PATH}/openal/alc/backends/wasapi.cpp" />
            <file name="${NATIVE_TOOLKIT_PATH}/openal/alc/backends/winmm.cpp" />

            <compilerflag value="-DNOMINMAX" />
            <compilerflag value="-DWIN32_LEAN_AND_MEAN" />
            <compilerflag value="-D_CRT_SECURE_NO_WARNINGS" if="isMsvc" />
            <compilerflag value="-D_DISABLE_CONSTEXPR_MUTEX_CONSTRUCTOR" if="isMsvc" />
            <compilerflag value="-D__USE_MINGW_ANSI_STDIO" if="mingw" />
            <compilerflag value="-utf-8" if="isMsvc" />

        </section>

        <section unless="windows">

            <compilerflag value="-fPIC" />
            <compilerflag value="-fvisibility=hidden" />
            <compilerflag value="-fno-math-errno" />
            <compilerflag value="-pthread" />

        </section>

        <section if="android">

            <compilerflag value="-fsigned-char" />
            <compilerflag value="-D__BIONIC_NO_PAGE_SIZE_MACRO" />

            <file name="${NATIVE_TOOLKIT_PATH}/openal/alc/backends/opensl.cpp" />

        </section>

    </files>

</xml>
