<xml>

	<!-- zlib-ng, built as zlib (ZLIB_COMPAT) with every symbol prefixed lime_ by
	     custom/zlib-ng/zlib_name_mangling.h, so that it can't clash with another zlib
	     linked into the same binary, such as hxcpp's. The headers in custom/zlib-ng are
	     the ones its CMake build generates in that configuration. The SIMD code for
	     each instruction set is in a group of its own, compiled with the flags it needs,
	     and zlib-ng picks it at run time where the CPU has it. -->

	<!-- MSVC takes no flags for intrinsics, and MinGW is GCC -->
	<set name="LIME_ZLIB_MSVC" value="1" if="windows" unless="mingw" />
	<set name="LIME_ZLIB_X86" value="1" unless="HXCPP_ARMV6 || HXCPP_ARMV7 || HXCPP_ARMV7S || HXCPP_ARM64 || rpi || emscripten" />
	<set name="LIME_ZLIB_ARM64" value="1" if="HXCPP_ARM64" unless="rpi" />
	<set name="LIME_ZLIB_ARM32" value="1" if="HXCPP_ARMV7 || HXCPP_ARMV7S" unless="rpi" />

