		<compilerflag value="-D_CRT_NONSTDC_NO_DEPRECATE" if="windows" />
		<compilerflag value="-DHAVE_BUILTIN_CTZ" unless="LIME_ZLIB_MSVC" />
		<compilerflag value="-DHAVE_BUILTIN_CTZLL" unless="LIME_ZLIB_MSVC" />

		<section if="LIME_ZLIB_X86">
			<compilerflag value="-DWITH_OPTIM" />
			<compilerflag value="-DX86_FEATURES" />
			<compilerflag value="-DX86_SSE2" />
			<compilerflag value="-DX86_SSSE3" />
			<compilerflag value="-DX86_SSE41" />
			<compilerflag value="-DX86_SSE42" />
